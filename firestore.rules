rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in (for now anonymous) user reads and writes only their own settings.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // planet is left over from the old Earth/Moon/Sun theme; older documents still carry it.
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['planet', 'language', 'currency', 'updatedAt'])
        && (!('currency' in request.resource.data) || request.resource.data.currency in ['TRY', 'EUR', 'USD', 'GBP'])
        && (!('language' in request.resource.data) || request.resource.data.language in ['en', 'tr', 'es', 'de', 'fr', 'it', 'pt', 'ru', 'ar', 'hi', 'zh', 'ja', 'ko', 'in', 'az']);
    }
  }
}
